{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "e2e:setup": "php tests/e2e/setup.php",
        "e2e:list": "playwright test --list",
        "e2e": "npm run e2e:setup && playwright test",
        "e2e:ui": "npm run e2e:setup && playwright test --ui"
    },
    "devDependencies": {
        "@playwright/test": "1.62.1",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
